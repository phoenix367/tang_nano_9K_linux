// Tang Nano 9K pins shared by all fit probes (same pins as the ov7670 serv_blink bring-up).
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP BANK_VCCIO=1.8;

IO_LOC "led" 10;
IO_PORT "led" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
