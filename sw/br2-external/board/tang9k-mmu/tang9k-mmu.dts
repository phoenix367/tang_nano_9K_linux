// Tang Nano 9K QERV SoC, stage 2: S-mode kernel with SV32 under the boot ROM's SBI v0.1 shim
// (doc/stage2_plan.md). Same memory map as stage 1. The boot ROM loads this DTB at 0x807FF000
// and passes it in a1. The CLINT belongs to the firmware (the kernel's timer goes through SBI
// set_timer and reads the time CSR), so it is not described here.
/dts-v1/;

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "tang9k,qerv-soc";
	model = "Tang Nano 9K QERV (MMU)";

	chosen {
		bootargs = "earlycon=uart8250,mmio,0x10000000,1000000 console=ttyS0";
		stdout-path = &uart0;
		/* "QRNGSEED" marker + 56 bytes: the boot ROM fills it with what entropy the board
		   has (sw/bootrom/bootrom.S seed_dtb); Linux credits it and its crng is ready at once. */
		rng-seed = [51 52 4e 47 53 45 45 44 00 00 00 00 00 00 00 00
			    00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			    00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			    00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00];
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x800000>;	/* 8 MB PSRAM */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* M-mode firmware stack/scratch (boot ROM SBI shim). Mapped, not used by Linux, so
		   the linear map keeps its 4 MB megapages. */
		sbi@807fe000 {
			reg = <0x0 0x807fe000 0x0 0x1000>;
		};

		/* HDMI framebuffer, 640 x 480 RGB565 (doc/video_plan.md). The video DMA reads it
		   straight from PSRAM, so Linux must only reach it through the uncached alias
		   (simple-framebuffer below); reserved here so nothing uses the cached address.
		   Mapped, like the SBI page, to keep the linear map's megapages. */
		framebuffer@80700000 {
			reg = <0x0 0x80700000 0x0 0x96000>;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <1000000>;		/* CLINT mtime / time CSR at 1 MHz */

		cpu0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv32ima";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
			mmu-type = "riscv,sv32";

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		/* 16550 register subset, fixed baud (divisor latch ignored), 256-byte FIFOs, its
		   interrupt on PLIC source 1. */
		uart0: serial@10000000 {
			compatible = "ns16550a";
			reg = <0x0 0x10000000 0x0 0x100>;
			clock-frequency = <16000000>;
			current-speed = <1000000>;
			fifo-size = <256>;
			interrupts-extended = <&plic 1>;
			no-loopback-test;
		};

		/* Minimal PLIC (rtl/soc/plic.v): one source, one context = the hart's S-mode
		   external interrupt. */
		plic: interrupt-controller@12000000 {
			compatible = "sifive,plic-1.0.0";
			reg = <0x0 0x12000000 0x0 0x400000>;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 9>;
			riscv,ndev = <2>;
		};

		/* Set up by the boot ROM (splash or cleared, scanout on) before it enters the kernel.
		   qervfb (patches/linux/0003): the framebuffer, and the video YOFF register
		   (SYSCON word 11) for Y-wrap panning. */
		framebuffer@90700000 {
			compatible = "qerv,tang9k-fb";
			reg = <0x0 0x90700000 0x0 0x96000>,	/* uncached alias of 0x80700000 */
			      <0x0 0x1110002c 0x0 0x4>;	/* YOFF */
			width = <640>;
			height = <480>;
			stride = <1280>;
		};

		/* qervcon (patches/linux/0004): the hardware text console. The text buffer
		   (80 x 30 cells, write-only) and the video registers CTRL..CURSOR (SYSCON words
		   8..13), which overlap the syscon node: the driver maps them without a request. */
		textcon@11800000 {
			compatible = "qerv,tang9k-text";
			reg = <0x0 0x11800000 0x0 0x1800>,
			      <0x0 0x11100020 0x0 0x18>;
		};

		/* OpenCores I2C master (rtl/i2c) on pins 25 (SDA) / 26 (SCL): 8-bit registers at
		   word offsets, interrupt = PLIC source 2. */
		i2c0: i2c@11300000 {
			compatible = "opencores,i2c-ocores";
			reg = <0x0 0x11300000 0x0 0x20>;
			reg-shift = <2>;
			reg-io-width = <4>;
			opencores,ip-clock-frequency = <42000000>;
			clock-frequency = <100000>;
			interrupts-extended = <&plic 2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		/* SPI master on the microSD slot (rtl/soc/spi_master.v, spi-qerv in
		   patches/linux/0005), the card in SPI mode through mmc_spi. SCK is 42 MHz / 2 at
		   most; the slot has no card-detect line, so mmc_spi polls. */
		spi@11400000 {
			compatible = "qerv,tang9k-spi";
			reg = <0x0 0x11400000 0x0 0x20>;
			clock-frequency = <42000000>;
			#address-cells = <1>;
			#size-cells = <0>;

			mmc@0 {
				compatible = "mmc-spi-slot";
				reg = <0>;
				spi-max-frequency = <21000000>;
				voltage-ranges = <3300 3300>;
			};
		};

		syscon: syscon@11100000 {
			compatible = "syscon";
			reg = <0x0 0x11100000 0x0 0x1000>;
		};

		poweroff {
			compatible = "syscon-poweroff";
			regmap = <&syscon>;
			offset = <0x0>;
			value = <0x5555>;
		};

		reboot {
			compatible = "syscon-reboot";
			regmap = <&syscon>;
			offset = <0x0>;
			value = <0x7777>;
		};
	};
};
