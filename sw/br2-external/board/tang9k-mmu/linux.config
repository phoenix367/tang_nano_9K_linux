# Linux 6.18 config for the Tang Nano 9K QERV SoC, stage 2 (doc/stage2_plan.md): S-mode kernel
# with SV32 MMU under the boot ROM's SBI v0.1 shim. Derived from board/tang9k/linux.config
# (stage 1); Buildroot runs olddefconfig on it.

# --- CPU / platform: RV32IMA, S-mode, SV32, no FPU, single hart
CONFIG_MMU=y
# CONFIG_RISCV_M_MODE is not set
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_FALLBACK is not set
# CONFIG_RISCV_PMU_SBI is not set
# EFI defaults to y with MMU, and it forces RISCV_ISA_C on (its "MZ" header is a compressed
# instruction). QERV has no C extension, and the boot ROM enters the Image directly.
# CONFIG_EFI is not set
# CONFIG_RISCV_SBI_CPUIDLE is not set
# CONFIG_CPU_IDLE is not set
# Keep the kernel linear map in megapages (one-level walks, fewer page-table pages)
# CONFIG_STRICT_KERNEL_RWX is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_KFENCE is not set
# CONFIG_COMPACTION is not set
# CONFIG_MIGRATION is not set
# CONFIG_KSM is not set
CONFIG_HZ_100=y
# SERV traps misaligned loads/stores: emulate them in the kernel, but skip the boot-time
# speed probe (PROBE, the default, runs a timing loop of misaligned accesses -> a trap storm).
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
# CONFIG_MODULES is not set

# --- Size
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB_TINY=y
CONFIG_BASE_SMALL=y
# CONFIG_RELOCATABLE is not set
# printk ring buffer + descriptors at the default shift 17 are ~528 KB; 4 KB is plenty.
CONFIG_LOG_BUF_SHIFT=12
# CONFIG_STACKPROTECTOR is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_FW_LOADER is not set
# CONFIG_HWMON is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_EVENTFD is not set
# CONFIG_FHANDLE is not set
# CONFIG_KALLSYMS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_IKCONFIG is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_KCMP is not set
# CONFIG_RSEQ is not set
# CONFIG_AIO is not set
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_HW_RANDOM is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_FANOTIFY is not set
# CONFIG_SECURITY is not set
# CONFIG_CRYPTO is not set

# --- Executables and root filesystem (initramfs linked into the Image, uncompressed)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# --- Devices: 16550 UART (polled) + earlycon, SBI timer (riscv,timer), syscon poweroff/reboot
CONFIG_TTY=y
# Legacy BSD ptys: pty_init registers 256 pairs as devices, which took 44 of the 55 s boot
# (initcall_debug). Unix98 ptys (devpts) stay; nothing here needs ptys anyway.
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_RISCV_TIMER=y
# CONFIG_SIFIVE_PLIC is not set
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_MFD_SYSCON=y

# --- Console output
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
