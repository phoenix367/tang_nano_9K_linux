# Tang Nano 9K stage 1: RV32IMA (no C/F/D) no-MMU M-mode Linux for the QERV SoC.
# Build with sw/build.sh. Kernel/DT also boot in perf/boot_trace (same memory map).

# Target: rv32ima, ilp32, no MMU -> uClibc-ng + elf2flt FLAT binaries
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVC is not set
BR2_RISCV_32=y
# BR2_RISCV_USE_MMU is not set
BR2_RISCV_ABI_ILP32=y
BR2_BINFMT_FLAT=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
# Size over speed for userspace. On RISC-V a FLAT binary's text cannot be shared or run in
# place: -fPIC code reaches its GOT pc-relatively (auipc), so text and data must stay at the
# linked distance and binfmt_flat copies the whole binary into one contiguous block per
# process (elf2flt -r). Every KB here counts, and busybox must fit a 512 KB (order-7) block.
BR2_OPTIMIZE_S=y
# Unwind tables land in the per-process data copy (~30 KB for busybox); nothing here needs them.
BR2_TARGET_OPTIMIZATION="-fno-asynchronous-unwind-tables -fno-unwind-tables"
# uClibc-ng links linuxthreads into libc (regex/signals reference it): ~24 KB data per process.
BR2_PTHREADS_NONE=y

# Reuse Buildroot's hash for the pinned kernel tarball
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# System: busybox init, no getty/login, no network
BR2_TARGET_GENERIC_HOSTNAME="tang9k"
BR2_TARGET_GENERIC_ISSUE="Tang Nano 9K / QERV"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_TANG9K_PATH)/board/tang9k/rootfs-overlay"

# Kernel: 6.18 LTS (what Buildroot 2026.08.1 tests for rv32 nommu), own config + DT
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_TANG9K_PATH)/board/tang9k/linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_TANG9K_PATH)/board/tang9k/tang9k.dts"

# Userspace: trimmed busybox only
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_TANG9K_PATH)/board/tang9k/busybox.config"

# Root filesystem: uncompressed cpio linked into the kernel Image (one file to load)
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_NONE=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
