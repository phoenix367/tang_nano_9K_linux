// Tang Nano 9K pins for fpga/src/tang9k_top.v. The PSRAM pins (O_psram_*, IO_psram_*) are
// placed by the PSRAM IP and need no IO_LOC. Flash pins from litex-boards
// sipeed_tang_nano_9k.py (the external 32 Mbit SPI NOR, not the embedded config flash).

IO_LOC "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// System reset: the button labelled S2 on this board is pin 3. (The Sipeed schematic names
// pin 3 S1 and pin 4 S2, but this board's silkscreen has them swapped; pressing "S1" hit pin 4.)
IO_LOC "btn_rst_n" 3;
IO_PORT "btn_rst_n" PULL_MODE=UP BANK_VCCIO=1.8;

IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "led_n[0]" 10;
IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[1]" 11;
IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[2]" 13;
IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[3]" 14;
IO_PORT "led_n[3]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[4]" 15;
IO_PORT "led_n[4]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[5]" 16;
IO_PORT "led_n[5]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;

IO_LOC "flash_sck" 59;
IO_PORT "flash_sck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
