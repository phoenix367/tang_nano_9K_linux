// Pins for fpga/probe_hdmi/hdmi_probe_top.v. HDMI pairs from litex-boards
// sipeed_tang_nano_9k.py (p,n): clock 69,68; data0 71,70; data1 73,72; data2 75,74.
// They are also the RGB LCD connector's lines: no LCD panel plugged in.
IO_LOC "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "tmds_clk_p" 69,68;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 71,70;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 73,72;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 75,74;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;

IO_LOC "led_n[0]" 10;
IO_PORT "led_n[0]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[1]" 11;
IO_PORT "led_n[1]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[2]" 13;
IO_PORT "led_n[2]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[3]" 14;
IO_PORT "led_n[3]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[4]" 15;
IO_PORT "led_n[4]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
IO_LOC "led_n[5]" 16;
IO_PORT "led_n[5]" PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.8;
